<decoder name="KongHTTP_parent">
  <type>web-log</type>
  <prematch>KongHTTP</prematch>
  <regex>^&lt;([0-9]+)&gt;([0-9]+) (.*? .*?) (.*?) (KongHTTP) (.*) ([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}) </regex>
  <order>Priority, Version, Time, Source, Component, ProcessID, MessageID</order>
</decoder>

<decoder name="KongHTTP_Body">
  <parent>KongHTTP_parent</parent>
  <prematch offset="after_parent">body=</prematch>
  <plugin_decoder offset="after_prematch">JSON_Decoder</plugin_decoder>
</decoder>