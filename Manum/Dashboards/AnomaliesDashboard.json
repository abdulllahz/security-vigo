      "pluginVersion": "12.2.0-16791878397",
      "targets": [
        {
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "columns": [],
              "database": "",
              "limit": 1000,
              "mode": "list",
              "queryType": "table",
              "table": ""
            }
          },
          "pluginVersion": "4.11.0",
          "queryType": "table",
          "rawSql": "WITH keys AS (\n    SELECT JSONExtractKeys(response.headers) AS key \n    FROM kong\n    WHERE $__timeFilter(timestamp)\n),\nranked_keys AS (\n    SELECT\n        key,\n        1/COUNT(*) as count\n    FROM keys\n    ARRAY JOIN key\n    GROUP BY key\n    ORDER BY count DESC\n)\nSELECT *\nFROM ranked_keys",
          "refId": "A"
        }
      ],
      "title": "Rare Response Header Keys",
      "type": "piechart"
    },
