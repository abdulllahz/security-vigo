                "options": "rpm"
              }
            }
          }
        ],
        "tooltip": {
          "hideZeros": false,
          "mode": "single",
          "sort": "none"
        }
      },
      "pluginVersion": "12.2.0-16791878397",
      "targets": [
        {
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "columns": [],
              "database": "",
              "limit": 1000,
              "mode": "list",
              "queryType": "table",
              "table": ""
            }
          },
          "pluginVersion": "4.11.0",
          "queryType": "table",
          "rawSql": "SELECT\n    date_trunc('minute', timestamp) as bucket,\n    JSONExtractString(request.headers,'x-app-user-id') as userid,\n    COUNT(timestamp) as rpm,\n    --reinterpretAsUInt256(reverse(unhex(userid)))%65535 as colorid,\n    rpm as colorid,\n    rpm/1000 as sizeid\nFROM kong\nWHERE $__timeFilter(timestamp) AND JSONExtractString(request.headers,'x-app-user-id') != ''\nGROUP BY bucket,userid\nORDER BY rpm DESC\nLIMIT 5000",
          "refId": "A"
        }
      ],
      "title": "Top Users by Traffic Rate",
      "type": "xychart"
    },
    {
