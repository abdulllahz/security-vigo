{
    "meta":["rewriter"],
    "name":"talos",
    "original_path": "/$(uri_captures['default'])",
    "original_host": "talos.bykea.net",
    "upstream":{
        "tags": ["Core","Auth","RateLimited","UserFacing"]
    },
    "targets":[
        {"target":"talos.bykea.net:443","weight":0,"tags":["CF-DNS"]},
        {"target":"talos-bykea-prod-829138484.eu-west-1.elb.amazonaws.com:443","weight":100,"tags":["AWS-ELB"]}
    ],

    "service":{
        "tags": ["Core","Critical","UserFacing","RateLimited"]
    },
    "routes":[{
        "name": "DEFAULT",
        "protocols": ["http","https"],
        "methods": ["GET","PUT","POST","PATCH","DELETE","OPTIONS","HEAD","TRACE"],
        "paths": ["~/talos/(?<default>.*)"],
        "tags": ["Universal Acceptor"]
    },
    {
        "name": "DEFAULTSocket",
        "protocols": ["http","https"],
        "methods": ["GET","PUT","POST","PATCH","DELETE","OPTIONS","HEAD","TRACE"],
        "paths": ["~/(?<default>socket.io.*)"],
        "tags": ["Universal Acceptor"]
    }]
}