{
    "name":"kronos",
    "upstream":{
        "tags": ["Core","Auth","RateLimited","UserFacing"]
    },
    "targets":[
        {"target":"kronos-kn.bykea.net:443","weight":0,"tags":["CF-DNS"]},
        {"target":"a0fe565fedcac4f6eb40ba9320e40e88-979311317.eu-west-1.elb.amazonaws.com:443","weight":100,"tags":["AWS-ELB"]}
    ],
    "service":{
        "tags": ["Core","Critical","UserFacing","RateLimited"],
        "meta": [{"rewriter":{"config":{"replace":{"headers":["Host: kronos-kn.bykea.net"],"uri":"/$(uri_captures['default'])"}}}}]
    },
    "routes":[
        {"methods": ["GET"] ,"paths": ["/kronos/health/heartbeat"],     "name":"DEFAULT","tags": ["InternalOnly","Utils","NonRegex"]},
        {"methods": ["POST"],"paths": ["/kronos/bookings"],             "name":"DEFAULT","tags": ["Regex"]},
        {"methods": ["GET"], "paths": ["/kronos/bookings"],             "name":"DEFAULT","tags": ["Regex"]},
        {"methods": ["POST"],"paths": ["/kronos/bykea/cash"],           "name":"DEFAULT","tags": ["Regex","ProbablyDead"]},
        {"methods": ["GET"], "paths": ["/kronos/partner/summary"],      "name":"DEFAULT","tags": ["Regex","PartnerApp","Core"]},
        {"methods": ["GET"], "paths": ["/kronos/bookings/partner"],     "name":"DEFAULT","tags": ["Regex"]},
        {"methods": ["GET"], "paths": ["/kronos/bookings/customer"],    "name":"DEFAULT","tags": ["Regex"]},
        {"methods": ["GET"], "paths": ["~/kronos/bookings/:id"],        "name":"DEFAULT","tags": ["Regex"]},
        {"methods": ["PUT"], "paths": ["~/kronos/bookings/:trip_id"],   "name":"DEFAULT","tags": ["Regex"]},
        {"methods": ["GET"], "paths": ["~/kronos/batch/:id/invoice"],   "name":"DEFAULT","tags": ["Regex"]},
        {"methods": ["GET"], "paths": ["~/kronos/bookings/:id/invoice"],"name":"DEFAULT","tags": ["Regex"]},
        {"methods": ["GET"], "paths": ["~/kronos/bookings/zendesk/:id"],"name":"DEFAULT","tags": ["Regex","Dead"]},
    {
        "name": "Test_Authenticated",
        "meta": [{"ratelimit":{"config":{"header_name":"X-App-User-Id","minute":30}}}],
        "methods": ["GET","PUT","POST","PATCH","DELETE","OPTIONS","HEAD","TRACE"],
        "paths": ["~/test_kronos/(?<default>.*)"],
        "headers": {"X-App-User-Id":["~*"]},
        "protocols": ["http","https"],
        "regex_priority": 50,
        "tags": ["Test Authenticated Acceptor"]
    },{
        "name": "Test_Unauthenticated",
        "methods": ["GET","PUT","POST","PATCH","DELETE","OPTIONS","HEAD","TRACE"],
        "paths": ["~/test_kronos/(?<default>.*)"],
        "protocols": ["http","https"],
        "regex_priority": 1,
        "tags": ["Test Unauthenticated Acceptor"]
    }]
}