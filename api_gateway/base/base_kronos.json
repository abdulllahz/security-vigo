{
    "name":"kronos",
    "upstream":{
        "tags": ["Core","Auth","RateLimited","UserFacing"]
    },
    "targets":[
        {"target":"kronos-kn.bykea.net:443","weight":0,"tags":["CF-DNS"]},
        {"target":"a0fe565fedcac4f6eb40ba9320e40e88-979311317.eu-west-1.elb.amazonaws.com:443","weight":100,"tags":["AWS-ELB"]}
    ],
    "service":{
        "tags": ["Core","Critical","UserFacing","RateLimited"],
        "meta": [{"rewriter":{"config":{"replace":{"headers":["Host: kronos-kn.bykea.net"],"uri":"/$(uri_captures['suffix'])"}}}}]
    },
    "routes":[
        {"meta": [{"ratelimit":{"config":{"header_name":"x-.*-user-token","minute":30}}}],"name":"DEFAULT","tags": ["Authenticated","Header","x-.*-user-token","Regex"],"methods": ["GET"], "paths": ["~/kronos/(?<suffix>batch/:id/invoice)"]    },
        {"meta": [{"ratelimit":{"config":{"header_name":"x-.*-user-token","minute":30}}}],"name":"DEFAULT","tags": ["Authenticated","Header","x-.*-user-token","Regex"],"methods": ["GET"], "paths": ["~/kronos/(?<suffix>bookings/:id/invoice)"] },
        {"meta": [{"ratelimit":{"config":{"header_name":"x-.*-user-token","minute":30}}}],"name":"DEFAULT","tags": ["Authenticated","Header","x-.*-user-token","Regex"],"methods": ["GET"], "paths": ["~/kronos/(?<suffix>bookings/customer)"]    },
        {"meta": [{"ratelimit":{"config":{"header_name":"x-.*-user-token","minute":30}}}],"name":"DEFAULT","tags": ["Authenticated","Header","x-.*-user-token","Regex"],"methods": ["GET"], "paths": ["~/kronos/(?<suffix>bookings/partner)"]     },
        {"meta": [{"ratelimit":{"config":{"header_name":"x-.*-user-token","minute":30}}}],"name":"DEFAULT","tags": ["Authenticated","Header","x-.*-user-token","Regex"],"methods": ["GET"], "paths": ["~/kronos/(?<suffix>bookings/:id)"]         },
        {"name":"DEFAULT","tags": ["Dead"]                                            ,"methods": ["GET"], "paths": ["~/kronos/(?<suffix>bookings/zendesk/:id)"] },
        {"name":"DEFAULT","tags": ["Dead"]                                            ,"methods": ["POST"],"paths": ["~/kronos/(?<suffix>bykea/cash)"]           },
        {"name":"DEFAULT","tags": ["InternalOnly","Utils","NonRegex"]                 ,"methods": ["GET"] ,"paths": ["~/kronos/(?<suffix>health/heartbeat)"]     },
        {"name":"DEFAULT","tags": ["Uauthenticated","Regex","PartnerApp","Core"]      ,"methods": ["GET"], "paths": ["~/kronos/(?<suffix>partner/summary)"]      },
        {"name":"DEFAULT","tags": ["Uauthenticated","Regex"]                          ,"methods": ["GET"], "paths": ["~/kronos/(?<suffix>bookings)"]             },
        {"name":"DEFAULT","tags": ["Uauthenticated","Regex"]                          ,"methods": ["POST"],"paths": ["~/kronos/(?<suffix>bookings)"]             },
        {"name":"DEFAULT","tags": ["Uauthenticated","Regex"]                          ,"methods": ["PUT"], "paths": ["~/kronos/(?<suffix>bookings/:trip_id)"]    },
    {
        "name": "Test_Authenticated",
        "meta": [{"ratelimit":{"config":{"header_name":"X-App-User-Id","minute":30}}}],
        "methods": ["GET","PUT","POST","PATCH","DELETE","OPTIONS","HEAD","TRACE"],
        "paths": ["~/test_kronos/(?<default>.*)"],
        "headers": {"X-App-User-Id":["~*"]},
        "protocols": ["http","https"],
        "regex_priority": 50,
        "tags": ["Test Authenticated Acceptor"]
    },{
        "name": "Test_Unauthenticated",
        "methods": ["GET","PUT","POST","PATCH","DELETE","OPTIONS","HEAD","TRACE"],
        "paths": ["~/test_kronos/(?<default>.*)"],
        "protocols": ["http","https"],
        "regex_priority": 1,
        "tags": ["Test Unauthenticated Acceptor"]
    }]
}