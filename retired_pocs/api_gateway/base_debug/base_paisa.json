{
    "name":"paisa",
    "upstream":{
        "tags": ["Core","Auth","RateLimited","UserFacing"]
    },
    "targets":[
        {"target":"sweet-ambulance-70.webhook.cool:443","weight":100,"tags":["AWS-ELB"]}
    ],
    "service":{
        "enabled": false,
        "tags": ["Core","Critical","UserFacing","RateLimited"],
        "meta": [{"rewriter":{"config":{"replace":{"headers":["Host: paisa.bykea.net"],"uri":"/$(uri_captures['suffix'])"}}}}]
    },
    "routes":[
    {"name": "QRGenerate","tags": ["Unauthenticated"],"methods": ["POST"],"paths": ["~/paisa/(?<suffix>raast/generate-qr-code)"]},
    {"name": "SendNotification","tags": ["Unauthenticated"],"methods": ["POST"],"paths": ["~/paisa/(?<suffix>raast/webhook/notify-transaction)"]},
    {
        "name": "DEFAULT",
        "protocols": ["http","https"],
        "methods": ["GET","PUT","POST","PATCH","DELETE","OPTIONS","HEAD","TRACE"],
        "paths": ["~/paisa/(?<default>.*)"],
        "tags": ["Universal Acceptor"]
    },{
        "name": "Test_Authenticated",
        "meta": [{"ratelimit":{"config":{"header_name":"X-App-User-Id","minute":30}}}],
        "methods": ["GET","PUT","POST","PATCH","DELETE","OPTIONS","HEAD","TRACE"],
        "paths": ["~/test_paisa/(?<default>.*)"],
        "headers": {"X-App-User-Id":["~*"]},
        "protocols": ["http","https"],
        "regex_priority": 50,
        "tags": ["Test Authenticated Acceptor"]
    },{
        "name": "Test_Unauthenticated",
        "methods": ["GET","PUT","POST","PATCH","DELETE","OPTIONS","HEAD","TRACE"],
        "paths": ["~/test_paisa/(?<default>.*)"],
        "protocols": ["http","https"],
        "regex_priority": 1,
        "tags": ["Test Unauthenticated Acceptor"]
    }]
}